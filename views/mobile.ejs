<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catálogo - Móvil</title>
    <style>
        body { font-family: sans-serif; margin: 0; background: #f8fafc; padding: 0.5rem; }
        header { background: #0f172a; color: white; padding: 0.75rem; text-align: center; font-weight: bold; }
        .card { background: white; margin-bottom: 0.75rem; padding: 0.75rem; border-radius: 6px; display: flex; gap: 0.75rem; align-items: center; }
        .card img { width: 70px; height: 70px; object-fit: cover; border-radius: 4px; }
        .info { flex: 1; }
        .info h4 { margin: 0 0 0.25rem 0; font-size: 0.9rem; }
        .price { font-weight: bold; color: #2563eb; }
        button { background: #2563eb; color: white; border: none; padding: 0.4rem 0.6rem; border-radius: 4px; }
    </style>
</head>
<body>
    <header>ServerTech (Móvil)</header>

    <main style="margin-top: 0.5rem;">
        <% products.forEach(p => { %>
            <div class="card">
                <img src="<%= p.img %>?w=200&q=50&fm=webp" alt="<%= p.name %>" loading="lazy">
                <div class="info">
                    <h4><%= p.name %></h4>
                    <!-- Sin tabla extensa de especificaciones -->
                    <div class="price">$<%= p.price %></div>
                </div>
                <button>Comprar</button>
            </div>
        <% }); %>
    </main>
</body>
</html>